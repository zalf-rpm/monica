[
  // Windows: the pixi build (pixi.toml, build.py) - the same as the CI, with Ninja
  // and MSVC found via vswhere, no developer prompt needed. Only the first build
  // of a build dir configures it; after that it reconfigures itself when needed.
  // The compile_commands.json copy is for clangd.
  {
    "label": "[Windows] Build Debug (pixi)",
    "command": "pixi run build -- --debug && Copy-Item _cmake_debug/compile_commands.json .",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    // after changes that confuse the existing cache
    "label": "[Windows] Reconfigure + Build Debug (pixi)",
    "command": "pixi run build -- --debug --reconfigure && Copy-Item _cmake_debug/compile_commands.json .",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "[Windows] Build Release (pixi)",
    "command": "pixi run build",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    // keeps the configured build dir and its vcpkg_installed/ (`pixi run clean` removes both)
    "label": "[Windows] Clean Debug (pixi)",
    "command": "pixi run cmake --build _cmake_debug --target clean",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "[Windows] Debug monica-run",
    "command": "raddbg _cmake_debug/monica-run.exe -m installer/Hohenfinow2/sim-min.json",
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "MONICA_PARAMETERS": "$ZED_WORKTREE_ROOT/../monica-parameters",
    },
  },
  // Linux: the Debug build in build/, in the Nix dev shell (flake.nix). `direnv
  // exec .` loads it via .envrc, which also configures build/ if it isn't yet.
  {
    "label": "[Linux] CMake Build",
    "command": "direnv exec . cmake --build build",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "[Linux] CMake Clean + Build",
    "command": "direnv exec . sh -c 'cmake --build build --target clean && cmake --build build'",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    // after CMakeLists.txt or dev shell changes that confuse the existing cache
    "label": "[Linux] CMake Reconfigure + Build",
    "command": "direnv exec . sh -c 'cmake --fresh -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Debug && cmake --build build'",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    // tests/README.md; compare against another run with `pixi run compare A B`
    "label": "[Linux] Test suites with build/monica-run",
    "command": "direnv exec . cmake --build build --target monica-run && pixi run test --monica build/monica-run --engine linux-debug --out build/test-results",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
]
