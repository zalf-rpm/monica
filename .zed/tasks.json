[
  // Windows: the pixi build (pixi.toml, build.py) - Ninja, vcpkg's libraries
  // and MSVC found via vswhere, no developer prompt needed. Only the first build
  // of a build dir configures it; after that it reconfigures itself when needed.
  // The compile_commands.json copy is for clangd.
  {
    "label": "[Windows] Build Debug (pixi)",
    "command": "pixi run build -- --debug && Copy-Item _cmake_debug/compile_commands.json .",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    // after changes that confuse the existing cache
    "label": "[Windows] Reconfigure + Build Debug (pixi)",
    "command": "pixi run build -- --debug --reconfigure && Copy-Item _cmake_debug/compile_commands.json .",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "[Windows] Build Release (pixi)",
    "command": "pixi run build",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    // keeps the configured build dir and its vcpkg_installed/ (`pixi run clean` removes both)
    "label": "[Windows] Clean Debug (pixi)",
    "command": "pixi run cmake --build _cmake_debug --target clean",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  // Linux: unchanged, the sibling vcpkg checkout (../vcpkg) into build/
  {
    "label": "[Linux] CMake Configure",
    "command": "cmake -S . -B build -G Ninja -DCMAKE_MAKE_PROGRAM='/home/berg/.local/share/JetBrains/Toolbox/apps/clion/bin/ninja/linux/x64/ninja' -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -DCMAKE_TOOLCHAIN_FILE='../vcpkg/scripts/buildsystems/vcpkg.cmake' -DVCPKG_TARGET_TRIPLET=x64-linux -DCMAKE_BUILD_TYPE=Debug;",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "[Linux] CMake Configure + Build",
    "command": "cmake -S . -B build -G Ninja -DCMAKE_MAKE_PROGRAM='/home/berg/.local/share/JetBrains/Toolbox/apps/clion/bin/ninja/linux/x64/ninja' -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -DCMAKE_TOOLCHAIN_FILE='../vcpkg/scripts/buildsystems/vcpkg.cmake' -DVCPKG_TARGET_TRIPLET=x64-linux -DCMAKE_BUILD_TYPE=Debug; cmake --build build --parallel",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "[Linux] CMake Clean + Build",
    "command": "cmake --build build --target clean; cmake --build build --parallel",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "[Linux] CMake Build",
    "command": "cmake --build build --parallel",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "[Windows] Raddbg: monica-run",
    "command": "raddbg _cmake_debug/monica-run.exe -m installer/Hohenfinow2/sim-min.json",
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "MONICA_PARAMETERS": "$ZED_WORKTREE_ROOT/../monica-parameters",
    },
  },
  {
    "label": "[Windows] Run: monica-run",
    "command": "_cmake_debug/monica-run.exe -m installer/Hohenfinow2/sim-min.json",
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "MONICA_PARAMETERS": "$ZED_WORKTREE_ROOT/../monica-parameters",
    },
  },
]
