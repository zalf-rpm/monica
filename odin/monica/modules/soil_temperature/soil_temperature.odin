// Soil temperature modules: Crop2ML packages (amei/<package>/, generated by
// `pixi run gen-amei`, never edited) behind one interface. See
// plan-crop2ml-modules.md §§1.2-1.3.
//
// Everything here works on Input/Output, never on Monica_Model: core imports
// this package (§1.7), so it can't import core. Gathering an Input from the
// model is core's job (soil_temperature_impl.odin), reading one from a file
// cmd/monica-module's.
//
// A new module (R3) is a file like monica_soiltemp.odin - its struct, its
// make/init/step/destroy and a constant Module_Entry, the table row, at its
// end - plus one line in the Module union and one in `modules` below.
package soil_temperature

import p "../../params"
import "base:runtime"

Allocator :: runtime.Allocator

// What the soil temperature modules read, in MONICA's units. Bindings convert
// to what their module expects. Layers are top down, one per MONICA layer.
Input :: struct {
	// site and parameters, constant over a run
	latitude:                f64, // [deg]
	albedo:                  f64, // [0-1] MONICA's environment albedo
	tav:                     f64, // annual average air temperature [°C]
	tamp:                    f64, // amplitude of the monthly average air temperatures [°C]
	time_step:               f64, // [d]
	kc_factor_bare_soil:     f64, // MONICA's soil moisture parameter KcFactor
	params:                  p.Soil_Temperature_Module_Parameters, // MONICA's own
	layer_thickness:         []f64, // [m]
	bulk_density:            []f64, // [kg m-3]
	saturation:              []f64, // [m3 m-3]
	organic_matter:          []f64, // [kg kg-1]
	organic_carbon:          []f64, // [kg kg-1]
	sand:                    []f64, // [kg kg-1]
	clay:                    []f64, // [kg kg-1]
	silt:                    []f64, // [kg kg-1]
	stones:                  []f64, // [m3 m-3]
	field_capacity:          []f64, // [m3 m-3]
	permanent_wilting_point: []f64, // [m3 m-3]

	using daily:             Daily,
	soil_moisture:           []f64, // per layer, daily [m3 m-3]
}

// The daily part of Input. MONICA's values are those before the day's soil
// moisture step (evaporation, ET0, snow: the previous day's), as in the C++
// AMEI adapters.
Daily :: struct {
	julian_day:             int, // day of the year, 1-366
	tmin, tavg, tmax:       f64, // [°C]
	globrad:                f64, // [MJ m-2 d-1]
	precip:                 f64, // [mm]
	irrigation:             f64, // [mm]
	wind:                   f64, // [m s-1]
	air_pressure:           f64, // as in the climate data, 1010 if it has none (C++ AMEI adapter)
	day_length:             f64, // [h] the climate's, or the astronomic one
	et0:                    f64, // reference evapotranspiration [mm]
	kc_factor:              f64, // MONICA's current Kc (the crop's, or KcFactor)
	actual_evaporation:     f64, // [mm]
	soil_coverage:          f64, // [0-1]
	snow_depth:             f64, // [mm]
	snow_water_equivalent:  f64, // [mm]
	temperature_under_snow: f64, // [°C]
	above_ground_biomass:   f64, // [kg ha-1]
	crop_height:            f64, // [m]
	lai:                    f64, // [m2 m-2]
}

Output :: struct {
	soil_surface_temperature: f64, // [°C]
	layer_temperature:        []f64, // per MONICA layer [°C]
}

make_output :: proc(no_of_layers: int, allocator := context.allocator) -> Output {
	return Output{layer_temperature = make([]f64, no_of_layers, allocator)}
}

destroy_output :: proc(o: ^Output, allocator := context.allocator) {
	delete(o.layer_temperature, allocator)
}

// One variant per module. The union, not a plain pointer, so that output paths
// can reach a module's own state by its type (e.g. module.Dssat_St.s.srftemp).
Module :: union {
	^Monica_Soil_Temp,
	^Dssat_St,
	^Dssat_Epicst,
	^Apsim_Campbell,
	^Bioma_Parton_Swat,
	^Bioma_Swat_Swat,
	^Simplace,
	^Sq,
	^Stics,
}

// A module's table row: its name and what MONICA calls. Each procedure gets the
// Module made by `make` and asserts its own variant (m.(^Dssat_St)).
Module_Entry :: struct {
	name:    string, // as in sim.json and the Crop2ML package
	make:    proc(allocator: Allocator) -> Module,
	// in_'s daily values are those of the first day: the modules' init reads
	// them, as in the C++ AMEI adapters, which call init right before the
	// first step
	init:    proc(m: Module, in_: ^Input, allocator: Allocator),
	// `allocator` is for the step's temporaries. A module that sizes state
	// arrays lazily in its first step (ApsimCampbell) gets them from the
	// allocator of that step, so callers pass a lasting one for the first step.
	step:    proc(m: Module, in_: ^Input, out: ^Output, allocator: Allocator),
	destroy: proc(m: Module, allocator: Allocator),
}

@(rodata)
modules := [?]Module_Entry {
	monica_soil_temp_entry,
	dssat_st_entry,
	dssat_epicst_entry,
	apsim_campbell_entry,
	bioma_parton_swat_entry,
	bioma_swat_swat_entry,
	simplace_entry,
	sq_entry,
	stics_entry,
}

find_module :: proc(name: string) -> (Module_Entry, bool) {
	for e in modules {
		if e.name == name {
			return e, true
		}
	}
	return {}, false
}

// Whole centimetres, rounded; the C++ AMEI adapters truncated
// (int(0.29 * 100) is 28).
@(private)
thickness_cm :: proc(m: f64) -> f64 {
	return f64(int(m * 100.0 + 0.5))
}
