// Soil temperature modules: Crop2ML packages (amei/<package>/, generated by
// `pixi run gen-amei`, never edited) behind one interface. See
// plan-crop2ml-modules.md §§1.2-1.3.
//
// Everything here works on Input/Output, never on Monica_Model: core imports
// this package (§1.7), so it can't import core. Gathering an Input from the
// model is core's job (soil_temperature_impl.odin), reading one from a file
// cmd/monica-module's.
//
// A module (R3) is a package like monica_soiltemp/ - its struct, its
// make/init/step/destroy and a constant Module_Entry at its end. It is built
// into MONICA by a line in core/builtin_modules.odin, which registers it here
// (`modules`), or into a plugin library (plugins.odin, plan-module-plugins.md).
package soil_temperature

import p "../../params"
import pl "../plugin"
import "base:runtime"

Allocator :: runtime.Allocator

// What the soil temperature modules read, in MONICA's units. Bindings convert
// to what their module expects. Layers are top down, one per MONICA layer.
Input :: struct {
	// site and parameters, constant over a run
	latitude:                f64 `unit:"deg"`,
	albedo:                  f64 `unit:"0-1"`, // MONICA's environment albedo
	tav:                     f64 `unit:"°C"`, // annual average air temperature
	tamp:                    f64 `unit:"°C"`, // amplitude of the monthly average air temperatures
	time_step:               f64 `unit:"d"`,
	kc_factor_bare_soil:     f64 `unit:"1"`, // MONICA's soil moisture parameter KcFactor
	params:                  p.Soil_Temperature_Module_Parameters, // MONICA's own
	layer_thickness:         []f64 `unit:"m"`,
	bulk_density:            []f64 `unit:"kg m-3"`,
	saturation:              []f64 `unit:"m3 m-3"`,
	organic_matter:          []f64 `unit:"kg kg-1"`,
	organic_carbon:          []f64 `unit:"kg kg-1"`,
	sand:                    []f64 `unit:"kg kg-1"`,
	clay:                    []f64 `unit:"kg kg-1"`,
	silt:                    []f64 `unit:"kg kg-1"`,
	stones:                  []f64 `unit:"m3 m-3"`,
	field_capacity:          []f64 `unit:"m3 m-3"`,
	permanent_wilting_point: []f64 `unit:"m3 m-3"`,

	using daily:             Daily,
	soil_moisture:           []f64 `unit:"m3 m-3"`, // per layer, daily
}

// The daily part of Input. MONICA's values are those before the day's soil
// moisture step (evaporation, ET0, snow: the previous day's), as in the C++
// AMEI adapters.
Daily :: struct {
	julian_day:             int `unit:"d"`, // day of the year, 1-366
	tmin, tavg, tmax:       f64 `unit:"°C"`,
	globrad:                f64 `unit:"MJ m-2 d-1"`,
	precip:                 f64 `unit:"mm"`,
	irrigation:             f64 `unit:"mm"`,
	wind:                   f64 `unit:"m s-1"`,
	air_pressure:           f64 `unit:"hPa"`, // as in the climate data, 1010 if it has none (C++ AMEI adapter)
	day_length:             f64 `unit:"h"`, // the climate's, or the astronomic one
	et0:                    f64 `unit:"mm"`, // reference evapotranspiration
	kc_factor:              f64 `unit:"1"`, // MONICA's current Kc (the crop's, or KcFactor)
	actual_evaporation:     f64 `unit:"mm"`,
	soil_coverage:          f64 `unit:"0-1"`,
	snow_depth:             f64 `unit:"mm"`,
	snow_water_equivalent:  f64 `unit:"mm"`,
	temperature_under_snow: f64 `unit:"°C"`,
	above_ground_biomass:   f64 `unit:"kg ha-1"`,
	crop_height:            f64 `unit:"m"`,
	lai:                    f64 `unit:"m2 m-2"`,
}

Output :: struct {
	soil_surface_temperature: f64 `unit:"°C"`,
	layer_temperature:        []f64 `unit:"°C"`, // per MONICA layer
}

make_output :: proc(no_of_layers: int, allocator := context.allocator) -> Output {
	return Output{layer_temperature = make([]f64, no_of_layers, allocator)}
}

destroy_output :: proc(o: ^Output, allocator := context.allocator) {
	delete(o.layer_temperature, allocator)
}

// A module: a pointer to its binding's struct, and that struct's type, for
// output paths into the module's own state (e.g. module.Dssat_St.s.srftemp,
// resolved through reflectpath's foreign types, core/module_paths.odin). A
// plugin's module is a ^pl.Instance (plugins.odin).
Module :: struct {
	data: rawptr,
	type: typeid,
}

// A module's table row: its name and what MONICA calls. Each procedure gets the
// Module made by `make` and casts its data ((^Dssat_St)(m.data)).
Module_Entry :: struct {
	name:    string, // as in sim.json and the Crop2ML package
	type:    typeid, // the struct `make` makes
	make:    proc(allocator: Allocator) -> Module,
	// in_'s daily values are those of the first day: the modules' init reads
	// them, as in the C++ AMEI adapters, which call init right before the
	// first step
	init:    proc(m: Module, in_: ^Input, allocator: Allocator),
	// `allocator` is for the step's temporaries. A module that sizes state
	// arrays lazily in its first step (ApsimCampbell) gets them from the
	// allocator of that step, so callers pass a lasting one for the first step.
	step:    proc(m: Module, in_: ^Input, out: ^Output, allocator: Allocator),
	destroy: proc(m: Module, allocator: Allocator),
	// a plugin module's (plugins.odin): make it with make_module, `make` is nil
	plugin:  ^pl.Module_Info,
}

// The built-in modules, registered at startup (core/builtin_modules.odin).
modules: [dynamic]Module_Entry

register_builtin :: proc(e: Module_Entry) {
	if modules == nil {
		modules = make([dynamic]Module_Entry, runtime.heap_allocator())
	}
	append(&modules, e)
}

// A built-in module, or one of a loaded plugin (plugins.odin).
find_module :: proc(name: string) -> (Module_Entry, bool) {
	for e in modules {
		if e.name == name {
			return e, true
		}
	}
	return find_plugin_module(name)
}

// Whole centimetres, rounded; the C++ AMEI adapters truncated
// (int(0.29 * 100) is 28).
thickness_cm :: proc(m: f64) -> f64 {
	return f64(int(m * 100.0 + 0.5))
}
