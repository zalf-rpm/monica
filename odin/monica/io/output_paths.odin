// NOT aliased, deliberately - the computed tier (plan-reflective-outputs.md
// §1). A path cannot express any of these, and faking one would be a silently
// wrong column rather than a missing one:
//
//   Date/DOY/Month/Year/days-since-start
//                 Date's year()/month()/dayOfYear()/toIsoDateString() are
//                 procs, not fields
//   Crop          a string built from the crop params
//   Stage         vc_DevelopmentalStage + 1
//   Count         the literal 1
//   ETa/ETc, Pot_ET, WaterContent, AWC, SOC-X-Y, PASW, Tmax>=40
//                 arithmetic over two or more fields
//   Yield, SecondaryYield, SOC, N, Nmin, NetNmin, Denit, Rh, NH3, Silt,
//   EffRootDep, AbBiomN, YieldN, YieldNc, Protein, GrainN, Nresid, Nstress,
//   PotNup, Ra, LightInterception1/2, ActNupLayer
//                 proc calls
//   OrgBiom, OrgGreenBiom, NPP-Organs, Ra-Organs
//                 guarded by speciesParams' organ COUNT, not by the array
//                 bound, so an out-of-range organ must read 0.0 even when the
//                 array has an element there
//   OrgN, Co, AOMf, AOMs, SMBf, SMBs, SOMf, SOMs, CBal, SMB-CO2-ER,
//   actammoxrate, actnitrate, actdenitrate
//                 these clamp fromLayer/toLayer to numberOfOrganicLayers()-1
//                 before aggregating, so a range past the organic layers
//                 repeats the last organic layer's value where reflection
//                 would report *missing* -> 0.0. Different numbers, not just
//                 a different route to them.

@(private)
g_legacy_aliases: map[string]Alias
@(private)
g_legacy_aliases_built: bool

legacy_aliases :: proc(allocator := context.allocator) -> ^map[string]Alias {
	if !g_legacy_aliases_built {
		// Built once and read for the rest of the process, so NOT from `allocator`
		// (one request's arena, in a server) - see tools.process_cache_allocator.
		// Its contents are all static-table literals, so nothing here depends on
		// the caller's data.
		g_legacy_aliases = make(map[string]Alias, len(g_alias_table), tl.process_cache_allocator())
		for e in g_alias_table {
			g_legacy_aliases[e.name] = e.alias
		}
		g_legacy_aliases_built = true
	}
	return &g_legacy_aliases
}

// A/B bisection escape hatch (sim.json: output."use-legacy-output-fns?").
// When true, parse_output_ids consults build_output_table before the alias
// table, i.e. the pre-reflection behaviour, so a moved CSV column can be
// pinned to the engine rather than to anything else in the same commit.
g_use_legacy_output_fns: bool

// The model as an `any` for the path engine. Built explicitly rather than by
// letting `model^` coerce: Monica_Model is large, and this makes it obvious
// that no copy happens and that resolve() writes through to the real fields.
@(private)
model_root :: proc(model: ^core.Monica_Model) -> any {
	return any{rawptr(model), typeid_of(core.Monica_Model)}
}

// Compiles `path` onto `oid` at setup time. The plan is heap-allocated in
// `allocator` (the run's arena) because OId is copied by value everywhere.
oid_bind_path :: proc(
	oid: ^OId,
	path: string,
	allocator := context.allocator,
) -> rp.Compile_Error {
	plan, err := rp.compile(typeid_of(core.Monica_Model), path, allocator)
	if rp.failed(err) {
		return err
	}
	p := new(rp.Path_Plan, allocator)
	p^ = plan
	oid.path = p.src
	oid.plan = p
	return rp.Compile_Error{}
}

// The daily read for a reflection-backed oid - the counterpart of
// `ofs[oid.id](model, oid)`.
//
// An open dimension goes through get_complex_values, which is the same
// procedure the layer-based lambdas (Mois/SOC/N) use, so fromLayer/toLayer/
// organ/layerAggOp behave identically on both tiers. Note the asymmetry that
// buys byte-identity: get_complex_values rounds each element of an
// unaggregated range but does NOT round an aggregated one, exactly as the
// C++ does.
resolve_oid_value :: proc(
	model: ^core.Monica_Model,
	oid: OId,
	allocator := context.allocator,
) -> jx.Value {
	if oid.plan.open_step >= 0 {
		return get_complex_values(model, oid, nil, oid.roundToDigits, allocator)
	}

	// A missing value - nil currentCropModule, unset Maybe, absent map key -
	// yields 0.0, matching every legacy lambda's `... ? ... : 0.0` ternary.
	v, ok := rp.resolve_f64(oid.plan, model_root(model))
	if !ok {
		v = 0.0
	}
	if oid.castTo == .INT {
		return jx.i(int(v))
	}
	return jx.f(round_or_not(v, oid.roundToDigits))
}

// ---------------------------------------------------------------------------
// the tier-agnostic read/write entry points
// ---------------------------------------------------------------------------
//
// Everything that reads or writes an oid goes through these two, so a caller
// never has to know whether the oid is lambda-backed or path-backed:
// store_results, the SetValue workstep, and the primitive-calc expression
// operands all just ask.

// Is there any way to read this oid?
@(require_results)
oid_has_getter :: proc(oid: OId) -> bool {
	if oid.plan != nil {
		return true
	}
	_, ok := build_output_table().ofs[oid.id]
	return ok
}

// C++: `ofs[oid.id](monica, oid)`, widened by the path tier.
oid_get_value :: proc(
	model: ^core.Monica_Model,
	oid: OId,
	allocator := context.allocator,
) -> (
	jx.Value,
	bool,
) {
	if oid.plan != nil {
		return resolve_oid_value(model, oid, allocator), true
	}
	if of, ok := build_output_table().ofs[oid.id]; ok {
		return of(model, oid), true
	}
	return jx.Value{}, false
}

// Is there any way to WRITE this oid?
//
// The path tier is what makes this interesting. Before it, exactly two of the
// C++'s 181 ids had a registered setf (Stage and Mois) - deliberately, but it
// means a model state that no one thought to expose was simply unreachable
// from a SetValue workstep. Any path-backed oid whose leaf is a real,
// writable number now is.
@(require_results)
oid_has_setter :: proc(oid: OId) -> bool {
	if oid.plan != nil && rp.is_writable(oid.plan) {
		return true
	}
	_, ok := build_output_table().setfs[oid.id]
	return ok
}

// C++: `setfs[oid.id](monica, oid, value)`, widened by the path tier.
//
// The path tier is tried FIRST, mirroring the read side's tier order
// (§2.5) so that a name cannot read through one tier and write through the
// other. That is safe for the two ids where both exist: `Mois`' C++ setf is a
// bare assignment to the same field its alias points at, and `Stage` - whose
// setf is *not* a bare assignment - has no alias row at all, because it is in
// the computed tier.
//
// Returns false when nothing was written, which is a real outcome and not
// just an error: a path through a nil `currentCropModule`, or an out-of-range
// layer, resolves to *missing*, and the C++ ternaries this mirrors skip the
// write too.
oid_set_value :: proc(
	model: ^core.Monica_Model,
	oid: OId,
	value: jx.Value,
	allocator := context.allocator,
) -> bool {
	if oid.plan != nil && rp.is_writable(oid.plan) {
		if oid.plan.open_step >= 0 {
			// the layer/organ range and the scalar-fills-every-layer rule are
			// set_complex_values', exactly as on the read side
			set_complex_values(model, oid, nil, value, allocator)
			return true
		}
		v, ok := json_to_f64(value)
		if !ok {
			return false
		}
		return rp.write_f64_at(oid.plan, model_root(model), v)
	}
	if setf, ok := build_output_table().setfs[oid.id]; ok {
		setf(model, oid, value)
		return true
	}
	return false
}

// The value side of a write. Numbers are numbers; a JSON bool is accepted as
// 1/0 so a bool-typed model field can be set the obvious way. Anything else -
// a string, an object, null - is not a write.
@(private)
json_to_f64 :: proc(value: jx.Value) -> (f64, bool) {
	if jx.is_number(value) {
		return jx.number_value(value), true
	}
	if jx.is_bool(value) {
		return jx.bool_value_of(value) ? 1 : 0, true
	}
	return 0, false
}

// The per-index write set_complex_values delegates to for a path-backed oid,
// the counterpart of the resolve_f64 call on the read side.
@(private)
set_plan_value_at :: proc(model: ^core.Monica_Model, oid: OId, i: int, value: jx.Value) {
	v, ok := json_to_f64(value)
	if !ok {
		return
	}
	rp.write_f64_at(oid.plan, model_root(model), v, i)
}

// tools.round(v, -1) rounds to TENS (the C++ round_to_digits takes a signed
// digit count and means it), so "do not round" needs its own branch rather
// than a sentinel passed through.
@(private)
round_or_not :: proc(v: f64, digits: int) -> f64 {
	if digits < 0 {
		return v
	}
	return tl.round(v, digits)
}

// Setup-time diagnostics. Reported once, with the offending spec - not once
// per day for 2,500 days.
@(private)
warn_bad_path :: proc(name: string, err: rp.Compile_Error) {
	fmt.eprintfln(
		"parse_output_ids: ignoring output %q - %s%s%s",
		name,
		err.msg,
		err.at == "" ? "" : " at segment ",
		err.at,
	)
}
