# syntax=docker/dockerfile:1
#
# NOT THE DEFAULT - kept as a reference. Use ./Dockerfile (Debian slim).
#
# This builds and runs fine (112 MB vs 198 MB for the Debian image), but its
# results are not the same as C++'s: the port calls the C library's
# pow/exp/log to stay bit-identical with C++ (CONVENTIONS.md §1), and musl's
# libm rounds differently from glibc's. On installer/Hohenfinow2/sim-min.json,
# 4,541 of 53,877 output cells (8%) differed from the glibc build, by up to
# 1.3% relative - small libm differences shift crop development thresholds
# and then compound. Only worth reviving with a glibc-identical libm (or if
# exact agreement with C++ stops mattering). It is not built by CI and not
# updated alongside ./Dockerfile, so expect to bring it up to date first.
#
#   docker build -f odin/Dockerfile.alpine -t monica-odin:alpine .
#
# Odin MONICA on Alpine - a drop-in for the C++ image (../Dockerfile): same
# /run/monica layout, same environment variables, same supervisord.conf
# (two monica-zmq-proxy + $monica_instances monica-zmq-server workers).
#
# Build from the REPO ROOT (the context needs ../docker as well as odin/):
#   docker build -f odin/Dockerfile -t zalfrpm/monica-odin .
# Unlike the C++ Dockerfile, which clones master, this builds the checked-out
# working tree - including the submodules, so check those out first.
#
# Pins come from odin/versions.json (see odin/UPDATING_VERSIONS.md): the Odin
# compiler via tools/odinw.py bootstrap, Cap'n Proto built from source here
# (Alpine's own capnproto package lags behind). zeromq is Alpine's.

ARG ALPINE_VERSION=3.24

FROM alpine:${ALPINE_VERSION} AS build

RUN apk add --no-cache build-base clang lld cmake ninja git python3 jq \
    zeromq-dev zlib-dev linux-headers

# Cap'n Proto first: it changes rarely and is the slowest step, so it gets its
# own layer keyed only on versions.json. Static + PIC, so the shim .so absorbs
# it and the runtime image needs no Cap'n Proto package.
COPY odin/versions.json /src/odin/versions.json
RUN v=$(jq -r .capnproto.version /src/odin/versions.json) \
    && git clone --depth 1 -b "v$v" https://github.com/capnproto/capnproto.git /src/capnproto \
    && cmake -S /src/capnproto -B /src/capnproto/build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DBUILD_SHARED_LIBS=OFF \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON -DWITH_OPENSSL=OFF \
        -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ \
    && cmake --build /src/capnproto/build \
    && cmake --install /src/capnproto/build \
    && rm -rf /src/capnproto

# The pinned Odin compiler (download + SHA256 check), again before the sources.
COPY odin/tools/odinw.py /src/odin/tools/odinw.py
RUN python3 /src/odin/tools/odinw.py bootstrap

COPY odin /src/odin
WORKDIR /src/odin

# The shim, where `odinw.py build` expects it. Not `odinw.py capnp-shim`: that
# is the pixi/vcpkg path; here everything is built against Alpine's musl.
RUN cmake -S support/capnp/shim_dynamic -B support/capnp/shim_dynamic/build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER=clang++ \
    && cmake --build support/capnp/shim_dynamic/build --target mas_capnp_dynamic_shim

# Unoptimized by default, like `pixi run build`: that is what the
# byte-identical comparison against C++ validates. --build-arg
# ODIN_BUILD_FLAGS=--release for -o:speed.
ARG ODIN_BUILD_FLAGS=
RUN python3 tools/odinw.py build ${ODIN_BUILD_FLAGS}

# Soil tables. The Odin port reads the .json variants, not .sercapnp.
ARG MONICA_PARAMETERS_REF=master
RUN git clone --depth 1 -b "${MONICA_PARAMETERS_REF}" \
        https://github.com/zalf-rpm/monica-parameters.git /src/monica-parameters


FROM alpine:${ALPINE_VERSION}

RUN apk add --no-cache zeromq libstdc++ libgcc zlib supervisor

ENV monica_dir=/run/monica
ENV supervisor_conf=/etc/supervisor/supervisord.conf
ENV monica_instances=3
ENV MONICA_WORK=/monica_data
ENV MONICA_HOME=${monica_dir}
ENV MONICA_PARAMETERS=${monica_dir}
ENV MONICA_CAPNP_SCHEMA_DIR=${monica_dir}/capnp_schemas
ENV monica_autostart_proxies=true
ENV monica_autostart_worker=true
ENV monica_auto_restart_proxies=true
ENV monica_auto_restart_worker=true
ENV monica_proxy_in_host=localhost
ENV monica_proxy_out_host=localhost
ENV monica_proxy_out_mode=-pps

ENV monica_intern_in_port=6677
ENV monica_intern_out_port=7788
ENV monica_consumer_port=7777
ENV monica_producer_port=6666

COPY docker/supervisord.conf ${supervisor_conf}
COPY docker/start_monica_supervisor.sh /start.sh

# Binaries plus libmas_capnp_dynamic_shim.so next to them (found via the
# $ORIGIN rpath odinw.py links with).
COPY --from=build /src/odin/build/monica-* /src/odin/build/libmas_capnp_dynamic_shim.so ${monica_dir}/
COPY --from=build /src/monica-parameters/soil/*.json ${monica_dir}/soil/
COPY --from=build /src/odin/support/capnp/shim/external/mas_capnproto_schemas/zalfmas_capnp_schemas ${MONICA_CAPNP_SCHEMA_DIR}

RUN mkdir -p ${MONICA_WORK} && chmod -R 777 ${MONICA_WORK} \
    && chmod -R +rx ${monica_dir} \
    && touch /var/log/supervisord.log && chmod 777 /var/log/supervisord.log \
    && adduser -D myuser
USER myuser

CMD ["sh", "/start.sh"]

EXPOSE ${monica_producer_port} ${monica_consumer_port} ${monica_intern_in_port} ${monica_intern_out_port}
