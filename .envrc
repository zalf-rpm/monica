use flake

# clangd (e.g. in Zed) needs a compile database: configure the Debug build in
# build/ once, if there isn't one yet. Configuring only takes seconds; building
# is left to the Zed tasks (.zed/tasks.json) or `cmake --build build`.
if [ ! -f build/compile_commands.json ]; then
  log_status "configuring the Debug build in build/ (compile_commands.json for clangd)"
  cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Debug > /dev/null ||
    log_error "configuring build/ failed - run: cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Debug"
fi
